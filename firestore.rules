rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validPost() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'type', 'title', 'description', 'date', 'imageUrl', 'storagePath',
          'published', 'createdBy', 'createdAt'
        ])
        && data.keys().hasAll([
          'type', 'title', 'description', 'date', 'imageUrl', 'storagePath',
          'published', 'createdBy', 'createdAt'
        ])
        && data.type in ['gallery', 'bulletin']
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.description is string && data.description.size() <= 500
        && data.date is string && data.date.size() <= 10
        && data.imageUrl is string && data.imageUrl.size() <= 2048
        && data.storagePath is string
        && data.storagePath.matches('^public/(gallery|bulletins)/[A-Za-z0-9._-]+$')
        && data.published == true
        && data.createdAt is timestamp;
    }

    match /admins/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /posts/{postId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create: if isAdmin() && validPost() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin() && validPost()
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin();
    }

    match /siteSettings/content {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['managed', 'updatedAt'])
        && request.resource.data.managed == true
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

