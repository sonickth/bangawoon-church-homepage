rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'sonickthgmal@gmail.com';
    }

    function validPost() {
      return request.resource.data.keys().hasOnly([
          'category', 'title', 'body', 'date', 'imageUrl', 'linkUrl', 'authorEmail', 'createdAt'
        ])
        && request.resource.data.category in [
          'sermons', 'bulletin', 'notices', 'calendar', 'gallery', 'community', 'nextgen', 'prayer'
        ]
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 20000
        && request.resource.data.date is string
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.createdAt == request.time;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isAdmin() && validPost();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
