rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'sonickthgmal@gmail.com'
        || (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function mayManageCategory(category) {
      return isAdmin() || (request.auth != null && category in ['gallery', 'prayer', 'sermon-share']);
    }

    function validPost() {
      return request.resource.data.keys().hasOnly([
          'category', 'title', 'body', 'date', 'imageUrl', 'fileUrl', 'filePath', 'fileName', 'fileType', 'attachments', 'linkUrl', 'authorEmail', 'authorUid', 'authorName', 'createdAt'
        ])
        && request.resource.data.category in [
          'sermons', 'bulletin', 'notices', 'calendar', 'gallery', 'community', 'nextgen', 'prayer', 'sermon-share'
        ]
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 20000
        && request.resource.data.date is string
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.authorUid == request.auth.uid
        && (!('authorName' in request.resource.data)
          || (request.resource.data.authorName is string
            && request.resource.data.authorName.size() > 0
            && request.resource.data.authorName.size() <= 40))
        && (!('attachments' in request.resource.data)
          || (request.resource.data.attachments is list && request.resource.data.attachments.size() <= 10))
        && request.resource.data.createdAt == request.time;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && mayManageCategory(request.resource.data.category)
        && validPost();
      allow update: if request.auth != null
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authorName'])
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 40;
      allow delete: if isAdmin() || (
        request.auth != null
        && resource.data.category in ['gallery', 'prayer', 'sermon-share']
        && resource.data.authorUid == request.auth.uid
      );
    }

    match /userProfiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'phoneNumber', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'displayName', 'phoneNumber', 'createdAt'])
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.phoneNumber is string
        && request.resource.data.phoneNumber.size() >= 9
        && request.resource.data.phoneNumber.size() <= 20
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /admins/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
