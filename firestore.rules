rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'sonickthgmal@gmail.com';
    }

    function mayManageCategory(category) {
      return isAdmin() || (request.auth != null && category in ['gallery', 'prayer']);
    }

    function validPost() {
      return request.resource.data.keys().hasOnly([
          'category', 'title', 'body', 'date', 'imageUrl', 'fileUrl', 'filePath', 'fileName', 'fileType', 'attachments', 'linkUrl', 'authorEmail', 'authorUid', 'createdAt'
        ])
        && request.resource.data.category in [
          'sermons', 'bulletin', 'notices', 'calendar', 'gallery', 'community', 'nextgen', 'prayer'
        ]
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 20000
        && request.resource.data.date is string
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.authorUid == request.auth.uid
        && (!('attachments' in request.resource.data)
          || (request.resource.data.attachments is list && request.resource.data.attachments.size() <= 10))
        && request.resource.data.createdAt == request.time;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && mayManageCategory(request.resource.data.category)
        && validPost();
      allow update: if false;
      allow delete: if isAdmin() || (
        request.auth != null
        && resource.data.category in ['gallery', 'prayer']
        && resource.data.authorUid == request.auth.uid
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
